{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/minimax-m3.1-flash:free",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "data/*.db": "deny",
      "data/*.db-*": "deny"
    },
    "edit": {
